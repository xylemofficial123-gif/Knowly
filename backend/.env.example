# Required — Infrastructure
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/knowledge_agent"
REDIS_URL="redis://localhost:6379"
QDRANT_URL="http://localhost:6333"

# Required — LLM (both free, no credit card needed)
GEMINI_API_KEY=""           # https://aistudio.google.com/apikey
OPENROUTER_API_KEY=""       # https://openrouter.ai

# Required — Google Drive/Meet OAuth
# Create at: Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID (Desktop)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_TRANSCRIPTS_FOLDER_ID=""    # Optional: specific folder for transcripts

# Optional — Other LLM providers (not used by default)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Optional — Slack (enable when ready)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional — ClickUp (enable when ready)
CLICKUP_API_KEY=""
CLICKUP_TEAM_ID=""

# Optional — Auth
CLERK_SECRET_KEY=""

# Tuning
NO_INDEX_CHANNEL_IDS=""
RELITIGATION_THRESHOLD=0.82
