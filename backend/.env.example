# --- Set these in Railway Dashboard → Variables ---

# Injected automatically by Railway plugins:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/knowledge_agent
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333

# LLM Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# Slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_SECRET=

# ClickUp
CLICKUP_API_KEY=
CLICKUP_TEAM_ID=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_JSON=
GOOGLE_TRANSCRIPTS_FOLDER_ID=
GOOGLE_DRIVE_FOLDER_IDS=

# Clerk
CLERK_SECRET_KEY=

# CORS — add any extra frontend URLs comma-separated
EXTRA_CORS_ORIGINS=https://xylem-memory.vercel.app

# Optional
NO_INDEX_CHANNEL_IDS=
RELITIGATION_THRESHOLD=0.82
BYPASS_ACL=false
