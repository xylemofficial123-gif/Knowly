{
  "manifest_version": 3,
  "name": "Xylem Side Chat",
  "version": "0.1.2",
  "description": "Floating mini chatbot on any website",
  "permissions": ["storage"],
  "host_permissions": [
    "<all_urls>",
    "https://knowledge-system-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
